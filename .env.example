# Copy to `.env` and fill in. Never commit the filled-in file.

# ---- Database (PostgreSQL) --------------------------------------------------
# Render gives you two URLs for the same database:
#   INTERNAL  postgresql://USER:PASS@dpg-<id>-a/DBNAME
#             Only resolves inside Render's network. Use this for the web service.
#   EXTERNAL  postgresql://USER:PASS@dpg-<id>-a.<region>-postgres.render.com/DBNAME?sslmode=require
#             Use this from a laptop or CI (prisma migrate deploy, studio, psql).
# Find both under Render → your database → "Connections".
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Optional. Postgres URL used by the integration test suite; it creates and drops
# a uniquely-named throwaway schema. Unset = integration tests skip.
TEST_DATABASE_URL=""

# ---- Auth -------------------------------------------------------------------
# 32+ chars. Changing this invalidates every existing session.
JWT_SECRET=""

# Token encryption at rest (32+ chars). Falls back to JWT_SECRET in dev.
# Changing this makes already-stored OAuth tokens undecryptable.
APP_ENCRYPTION_KEY=""

# ---- App --------------------------------------------------------------------
# Public base URL (OAuth redirects + Stripe return URLs). No trailing slash.
APP_URL="http://localhost:3000"

# ---- AI provider (optional — falls back to a deterministic mock reviewer) ----
DEEPSEEK_API_KEY=""
AI_MODEL="deepseek-chat"

# ---- Stripe billing (optional — billing UI shows "not configured" until set) -
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_PREMIUM=""

# ---- Social OAuth (optional — audit falls back to manual connect until set) --
# Per platform: SOCIAL_<PLATFORM>_CLIENT_ID / _CLIENT_SECRET
SOCIAL_SPOTIFY_CLIENT_ID=""
SOCIAL_SPOTIFY_CLIENT_SECRET=""
SOCIAL_YOUTUBE_CLIENT_ID=""
SOCIAL_YOUTUBE_CLIENT_SECRET=""
SOCIAL_FACEBOOK_CLIENT_ID=""
SOCIAL_FACEBOOK_CLIENT_SECRET=""
SOCIAL_INSTAGRAM_CLIENT_ID=""
SOCIAL_INSTAGRAM_CLIENT_SECRET=""
SOCIAL_TIKTOK_CLIENT_ID=""
SOCIAL_TIKTOK_CLIENT_SECRET=""
SOCIAL_X_CLIENT_ID=""
SOCIAL_X_CLIENT_SECRET=""
