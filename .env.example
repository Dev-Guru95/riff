# Copy to `.env` and fill in. Never commit the filled-in file.

# ---- Database (PostgreSQL) --------------------------------------------------
# Render gives you two URLs for the same database:
#   INTERNAL  postgresql://USER:PASS@dpg-<id>-a/DBNAME
#             Only resolves inside Render's network. Use this for the web service.
#   EXTERNAL  postgresql://USER:PASS@dpg-<id>-a.<region>-postgres.render.com/DBNAME?sslmode=require
#             Use this from a laptop or CI (prisma migrate deploy, studio, psql).
# Find both under Render → your database → "Connections".
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Optional. Postgres URL used by the integration test suite; it creates and drops
# a uniquely-named throwaway schema. Unset = integration tests skip.
TEST_DATABASE_URL=""

# ---- Auth -------------------------------------------------------------------
# 32+ chars. Changing this invalidates every existing session.
JWT_SECRET=""

# Token encryption at rest (32+ chars). Falls back to JWT_SECRET in dev.
# Changing this makes already-stored OAuth tokens undecryptable.
APP_ENCRYPTION_KEY=""

# ---- App --------------------------------------------------------------------
# Public base URL (OAuth redirects + Stripe return URLs). No trailing slash.
APP_URL="http://localhost:3000"

# ---- AI provider (optional — falls back to a deterministic mock reviewer) ----
DEEPSEEK_API_KEY=""
AI_MODEL="deepseek-chat"

# ---- Stripe billing (optional — billing UI shows "not configured" until set) -
# KEEP THIS FILE AND YOUR LOCAL .env ON TEST KEYS. `npm run dev` reads .env, so a
# live secret key here would make local development create real charges. Live
# keys belong only in the production environment. Going-live runbook: docs/BILLING.md
# Secret key: server only. Never expose it to the browser or commit it.
STRIPE_SECRET_KEY=""
# Publishable key: safe in the client. Only Stripe value that may be shipped.
STRIPE_PUBLISHABLE_KEY=""
# Signing secret of the webhook endpoint pointing at /api/webhooks/stripe.
# Each endpoint (test, live, `stripe listen`) has its OWN secret — using the
# wrong one makes every delivery fail signature verification with a 400.
STRIPE_WEBHOOK_SECRET=""
# Recurring price ids. Created with lookup keys riff_pro_monthly /
# riff_premium_monthly and metadata plan=pro|premium, so the app can still map a
# price back to a plan if these ever go missing.
STRIPE_PRICE_PRO=""
STRIPE_PRICE_PREMIUM=""

# ---- RevenueCat (optional — cross-platform entitlement mirror) --------------
# Stripe charges the card; RevenueCat mirrors the entitlement so the same user
# signing in from another platform resolves to the same plan. With these unset,
# billing works web-only and every RevenueCat call is skipped.
#
# PUBLIC SDK key of the RevenueCat *Stripe* app (RevenueCat → Project →
# API keys). This is the key POST /v1/receipts expects — it is a RevenueCat
# key, not a Stripe one, despite the name.
REVENUECAT_STRIPE_PUBLIC_API_KEY=""
# Secret v1 key. Only needed to read entitlements back (restore purchases).
REVENUECAT_SECRET_API_KEY=""
# The exact string set as the webhook "Authorization header value" in the
# RevenueCat dashboard. /api/webhooks/revenuecat refuses every request unless
# this (or the signing secret below) is configured and matches.
REVENUECAT_WEBHOOK_AUTHORIZATION=""
# Optional HMAC signing secret for the same webhook. Set both for defence in depth.
REVENUECAT_WEBHOOK_SIGNING_SECRET=""

# ---- Social OAuth (optional — audit falls back to manual connect until set) --
# Per platform: SOCIAL_<PLATFORM>_CLIENT_ID / _CLIENT_SECRET
SOCIAL_SPOTIFY_CLIENT_ID=""
SOCIAL_SPOTIFY_CLIENT_SECRET=""
SOCIAL_YOUTUBE_CLIENT_ID=""
SOCIAL_YOUTUBE_CLIENT_SECRET=""
SOCIAL_FACEBOOK_CLIENT_ID=""
SOCIAL_FACEBOOK_CLIENT_SECRET=""
SOCIAL_INSTAGRAM_CLIENT_ID=""
SOCIAL_INSTAGRAM_CLIENT_SECRET=""
SOCIAL_TIKTOK_CLIENT_ID=""
SOCIAL_TIKTOK_CLIENT_SECRET=""
SOCIAL_X_CLIENT_ID=""
SOCIAL_X_CLIENT_SECRET=""

# Where uploaded files are stored. Must be OUTSIDE the app directory in production
# so deploys (which replace the app folder) keep them, e.g. /home/riff/uploads.
# Defaults to ./storage/uploads.
UPLOAD_DIR=
