# Copy to .env.local (git-ignored). Only PUBLIC values: EXPO_PUBLIC_* is bundled into the app.
# development | testing | production — picks the backend (see src/config/env.ts)
EXPO_PUBLIC_APP_ENV=development
# Optional override, e.g. a local `pnpm dev` reachable from your phone:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
