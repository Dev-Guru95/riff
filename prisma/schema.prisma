// Riff — AI Music Artist Education Platform
// Runs on PostgreSQL (Render). Statuses are stored as strings (see
// src/lib/constants.ts) rather than native enums, which keeps the schema
// portable; restore native enums/arrays/pgvector here if you ever want them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Identity & Profile =====
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("artist") // artist | admin | reviewer | moderator
  countryCode  String?
  status       String   @default("active")
  mfaEnabled   Boolean  @default(false)
  mfaSecret    String?
  // Skool community membership. Gates Community + AI Coach. Access is granted by
  // ADMIN VERIFICATION only. A user can request access (skoolRequestedAt); an
  // admin then verifies (skoolMember). Seam for a real Skool webhook later.
  skoolMember  Boolean  @default(false)
  skoolRequestedAt DateTime?
  skoolJoinedAt DateTime?
  skoolHandle  String?
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  profile      ArtistProfile?
  enrollments  Enrollment[]
  lessonProgress LessonProgress[]
  quizAttempts QuizAttempt[]
  submissions  Submission[]
  xpLedger     XpLedger[]
  level        UserLevel?
  badges       UserBadge[]
  streak       Streak?
  userMissions UserMission[]
  coachThreads CoachThread[]
  coachMemories CoachMemory[]
  roadmaps     Roadmap[]
  socialAccounts SocialAccount[]
  auditSnapshots AuditSnapshot[]
  auditReports AuditReport[]
  threads      Thread[]
  posts        Post[]
  groupMembers GroupMember[]
  subscription Subscription?
  certificates Certificate[]

  // Project management (Kanban boards) — see "Project Management" section below.
  boardsOwned      Board[]
  boardMemberships BoardMember[]
  cardAssignments  CardAssignee[]
  cardWatches      CardWatcher[]
  cardComments     Comment[]
  cardAttachments  Attachment[]
  boardActivity    ActivityLog[]
  aiDrafts         AiDraft[]
  brandKit         BrandKit?
  financeEntries   FinanceEntry[]
  merchItems       MerchItem[]
  gigs             Gig[]
  careerGoals      CareerGoal[]
  fans             Fan[]
  broadcasts       Broadcast[]
  linkPage         LinkPage?
  bookings         Booking[]
}

// ===== Certificates =====
// The single program-completion credential. Issued ONCE per artist, the moment
// they finish EVERY published course in the program (see src/lib/certificates.ts).
// Shareable to the Skool community. `serial` is a public, unguessable id used for
// the shareable view. `programKey` is the seam for supporting multiple programs
// later — today there is one program ("riff").
model Certificate {
  id         String   @id @default(cuid())
  serial     String   @unique @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  programKey String   @default("riff")
  title      String
  issuedAt   DateTime @default(now())

  @@unique([userId, programKey])
  @@index([userId, issuedAt])
}

// ===== Project Management (Kanban Boards) =====
// A native, Trello-style project-management surface. The BOARD is the unit of
// collaboration: each board carries its own member list with per-board roles
// (owner | admin | manager | member | guest) via BoardMember — there is no
// separate "team"/"org" layer. All conventions mirror the rest of this schema:
// cuid ids, `orderIndex Int` ordering, String "enums" with inline value comments
// (typed unions live in src/lib/constants.ts), and explicit composite-PK join
// tables for many-to-many. Additive only — no existing model is modified beyond
// User back-relations.

model Board {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String   @default("")
  color       String   @default("brand") // ui accent token: brand | accent | success | warning | brand-2
  // Template this board was created from — drives its seeded columns/labels and
  // the specialized track tool it represents.
  kind        String   @default("generic") // generic | content_calendar | release_planner | pitch_tracker | outreach_crm | collab_board
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  BoardMember[]
  columns  BoardColumn[]
  cards    Card[]
  labels   Label[]
  activity ActivityLog[]

  @@index([ownerId, archived])
}

// Board membership + per-board role. Copy of the GroupMember join pattern.
model BoardMember {
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member") // owner | admin | manager | member | guest
  createdAt DateTime @default(now())

  @@id([boardId, userId])
  @@index([userId])
}

// A column/list within a board (To Do, In Progress, …). Named BoardColumn to
// avoid the SQL reserved word "Column".
model BoardColumn {
  id         String   @id @default(cuid())
  boardId    String
  board      Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title      String
  orderIndex Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cards Card[]

  @@index([boardId, orderIndex])
}

model Card {
  id              String      @id @default(cuid())
  boardId         String
  board           Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  columnId        String
  column          BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  title           String
  description     String      @default("") // markdown
  orderIndex      Int
  priority        String? // low | medium | high | urgent
  dueDate         DateTime?
  startDate       DateTime?
  estimateMinutes Int?
  completion      Int         @default(0) // 0..100
  archived        Boolean     @default(false)
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  assignees   CardAssignee[]
  watchers    CardWatcher[]
  labels      CardLabel[]
  checklists  Checklist[]
  comments    Comment[]
  attachments Attachment[]

  @@index([columnId, orderIndex])
  @@index([boardId, archived])
  @@index([boardId, dueDate])
}

// Board-scoped label definition; attached to cards via CardLabel.
model Label {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name      String   @default("")
  color     String   @default("brand") // brand | accent | success | warning | brand-2 | muted
  createdAt DateTime @default(now())

  cards CardLabel[]

  @@index([boardId])
}

model CardLabel {
  cardId  String
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
}

model CardAssignee {
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([cardId, userId])
  @@index([userId])
}

model CardWatcher {
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([cardId, userId])
  @@index([userId])
}

model Checklist {
  id         String   @id @default(cuid())
  cardId     String
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  title      String   @default("Checklist")
  orderIndex Int
  createdAt  DateTime @default(now())

  items ChecklistItem[]

  @@index([cardId, orderIndex])
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  text        String
  done        Boolean   @default(false)
  orderIndex  Int
  createdAt   DateTime  @default(now())

  @@index([checklistId, orderIndex])
}

model Comment {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String // markdown
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId, createdAt])
}

model Attachment {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  name      String
  mime      String   @default("")
  size      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([cardId, createdAt])
}

// Append-only per-board / per-card activity feed. `cardId` is a bare nullable
// column (board-level events have none) queried directly — mirrors the
// Notification/AnalyticsEvent "no FK on the hot column" precedent.
model ActivityLog {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cardId    String?
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  verb      String // created | renamed | moved | updated | archived | commented | assigned | ...
  meta      String   @default("{}") // JSON
  createdAt DateTime @default(now())

  @@index([boardId, createdAt])
  @@index([cardId, createdAt])
}

model ArtistProfile {
  userId       String  @id
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageName    String?
  genres       String  @default("[]") // JSON array of strings
  careerStage  String  @default("beginner") // beginner | rising | working
  audienceSize Int     @default(0)
  goals        String  @default("[]") // JSON array
  timezone     String  @default("UTC")
}

// ===== Course Domain =====
model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  level       String   @default("beginner")
  isPublished Boolean  @default(false)
  orderIndex  Int      @default(0)
  version     Int      @default(1)
  // Where to send the learner once they finish this track. The teaching for a
  // track lives in Skool and the assessment lives here, so completing a track
  // has to hand the learner back — normally to the NEXT Skool track. Null falls
  // back to SKOOL_URL (the community root) so the loop still closes.
  returnUrl   String?
  returnLabel String?
  modules     Module[]
  enrollments Enrollment[]
}

model Module {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title      String
  orderIndex Int
  lessons    Lesson[]
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  orderIndex  Int
  content     String   @default("") // markdown / rich content
  estMinutes  Int      @default(5)
  xpReward    Int      @default(20)
  quiz        Quiz?
  assignment  Assignment?
  progress    LessonProgress[]
}

model Quiz {
  id            String   @id @default(cuid())
  lessonId      String   @unique
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  passThreshold Int      @default(80)
  xpReward      Int      @default(30)
  questions     QuizQuestion[]
  attempts      QuizAttempt[]
}

model QuizQuestion {
  id          String @id @default(cuid())
  quizId      String
  quiz        Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type        String @default("single") // single | multi | truefalse
  prompt      String
  options     String // JSON array of {id,text}
  correct     String // JSON array of option ids
  explanation String @default("")
  orderIndex  Int    @default(0)
}

model Assignment {
  id             String   @id @default(cuid())
  lessonId       String   @unique
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title          String
  instructions   String
  acceptedTypes  String   @default("[\"image\",\"link\",\"text\"]") // JSON array
  rubric         String   @default("[]") // JSON weighted criteria
  xpReward       Int      @default(60)
  minPassingScore Int     @default(60)
  submissions    Submission[]
}

// ===== Progress =====
model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  progressPct Float     @default(0)

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status      String    @default("available") // locked | available | in_progress | completed
  completedAt DateTime?
  timeSpentSec Int      @default(0)

  @@unique([userId, lessonId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score     Int
  passed    Boolean
  answers   String   // JSON
  attemptNo Int      @default(1)
  createdAt DateTime @default(now())
}

model Submission {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignmentId    String
  assignment      Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  artifactType    String   @default("text")
  artifactUrls    String   @default("[]") // JSON array
  externalLink    String?
  textContent     String?
  status          String   @default("processing") // processing | reviewed | flagged | resubmit
  aiScore         Int?
  strengths       String?  // JSON array
  weaknesses      String?  // JSON array
  recommendations String?  // JSON array
  nextActions     String?  // JSON array
  confidence      Float?
  humanReviewed   Boolean  @default(false)
  createdAt       DateTime @default(now())
}

// ===== Gamification =====
model XpLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  source    String   // lesson | quiz | assignment | mission | streak | bonus
  refId     String?
  createdAt DateTime @default(now())

  @@unique([userId, source, refId]) // idempotency guard
  @@index([userId, createdAt])
}

model UserLevel {
  userId     String @id
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXp    Int    @default(0)
  levelIndex Int    @default(0)
  levelKey   String @default("beginner_artist")
}

model Badge {
  id          String      @id @default(cuid())
  key         String      @unique
  name        String
  description String
  icon        String      @default("🏅")
  tier        String      @default("bronze")
  users       UserBadge[]
}

model UserBadge {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now())

  @@id([userId, badgeId])
}

model Streak {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentLen       Int      @default(0)
  longestLen       Int      @default(0)
  lastActivityDate String?  // YYYY-MM-DD
  freezeTokens     Int      @default(2)
}

// ===== Missions =====
model Mission {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String   @default("content") // branding | content | engagement | release
  xpReward    Int      @default(100)
  badgeKey    String?  // optional badge awarded on completion
  weekKey     String?  // YYYY-Www — rotating weekly mission set
  activeFrom  DateTime @default(now())
  activeTo    DateTime?
  userMissions UserMission[]
}

model UserMission {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId   String
  mission     Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  status      String    @default("assigned") // assigned | submitted | completed | expired
  completedAt DateTime?

  @@unique([userId, missionId])
}

// ===== Monetization & Admin =====
model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  type           String   @default("percent") // percent | fixed | reward
  value          Float    @default(0)
  description    String   @default("")
  maxRedemptions Int      @default(0) // 0 = unlimited
  redeemed       Int      @default(0)
  active         Boolean  @default(true)
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
}

// AI-suggested content updates awaiting admin review/approval.
model ContentSuggestion {
  id           String   @id @default(cuid())
  targetType   String   // course | lesson | trend
  targetId     String?
  title        String
  rationale    String
  suggested    String   @default("{}") // JSON diff/content
  sourceUrls   String   @default("[]") // JSON array
  status       String   @default("pending") // pending | approved | rejected
  reviewedById String?
  createdAt    DateTime @default(now())
}

// Append-only trail of privileged actions.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String?
  meta      String   @default("{}") // JSON
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
}

// ===== AI Coach =====
model CoachThread {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  messages  CoachMessage[]

  @@index([userId, createdAt])
}

model CoachMessage {
  id        String   @id @default(cuid())
  threadId  String
  thread    CoachThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String   // user | assistant | system
  content   String
  feedback  String?  // up | down | null — coach quality feedback loop
  createdAt DateTime @default(now())
}

// Distilled, durable facts the coach personalizes from (RAG memory).
model CoachMemory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // goal | genre | audience | insight | preference
  content   String
  weight    Float    @default(1)
  updatedAt DateTime @default(now())

  @@index([userId, kind])
}

// ===== Career Roadmap =====
model Roadmap {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  horizon       String   // 30d | 90d | 6m | 12m
  plan          String   @default("{}") // JSON { summary, milestones:[{title, tasks[]}] }
  generatedFrom String   @default("{}") // JSON snapshot of inputs
  isCurrent     Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([userId, horizon])
}

// ===== Social Audit =====
model SocialAccount {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     String    // instagram | tiktok | youtube | facebook | x | spotify
  handle       String
  externalId   String?   // provider account id
  accessToken  String?   // AES-256-GCM encrypted
  refreshToken String?   // AES-256-GCM encrypted
  expiresAt    DateTime?
  scopes       String?   // space-separated granted scopes
  connectVia   String    @default("manual") // manual | oauth
  status       String    @default("active") // active | expired | revoked
  connectedAt  DateTime  @default(now())

  @@unique([userId, platform])
}

// ===== Billing =====
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String    @default("free") // free | pro | premium
  status               String    @default("active") // active | trialing | past_due | canceled
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model AuditSnapshot {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String
  capturedAt DateTime @default(now())
  metrics    String   @default("{}") // JSON: followers, posts, engRate, reach...

  @@index([userId, platform, capturedAt])
}

model AuditReport {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart      DateTime
  periodEnd        DateTime
  marketingScore   Int
  brandingScore    Int
  growthScore      Int
  consistencyScore Int
  deltas           String   @default("{}") // JSON vs previous report
  recommendations  String   @default("[]") // JSON array
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

// ===== Community =====
model Forum {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  genre       String?
  orderIndex  Int      @default(0)
  threads     Thread[]
}

model Thread {
  id        String   @id @default(cuid())
  forumId   String
  forum     Forum    @relation(fields: [forumId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  kind      String   @default("discussion") // discussion | showcase | feedback
  link      String?  // for showcases / feedback requests
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  posts     Post[]

  @@index([forumId, createdAt])
}

model Post {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

model AccountabilityGroup {
  id        String   @id @default(cuid())
  name      String
  genre     String?
  capacity  Int      @default(10)
  createdAt DateTime @default(now())
  members   GroupMember[]
}

model GroupMember {
  groupId  String
  group    AccountabilityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@id([groupId, userId])
}

// ===== Moderation =====
model Report {
  id           String   @id @default(cuid())
  reporterId   String
  targetType   String   // thread | post | user
  targetId     String
  reason       String
  status       String   @default("open") // open | resolved | dismissed
  reviewedById String?
  createdAt    DateTime @default(now())

  @@index([status, createdAt])
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockerId])
}

// ===== Notifications =====
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // badge | levelup | mission | audit | reward | community | system
  title     String
  body      String   @default("")
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

// ===== Analytics =====
model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String   // lesson_complete | quiz_pass | assignment_submit | xp_earned | streak | audit_run | coach_message | mission_complete | login | signup
  meta      String   @default("{}") // JSON
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([userId, createdAt])
}

// ===== Monetization =====
model CouponRedemption {
  couponId   String
  userId     String
  redeemedAt DateTime @default(now())

  @@id([couponId, userId])
}

// ===== Leaderboard history =====
model LeaderboardSnapshot {
  id         String   @id @default(cuid())
  userId     String
  scope      String   // global | country:XX | genre:yyy
  rank       Int
  composite  Float
  periodKey  String   // YYYY-Www
  capturedAt DateTime @default(now())

  @@index([scope, periodKey, rank])
  @@index([userId, capturedAt])
}

// ===== Studio: AI Builders =====
// A generic AI-scored work item for the "builder" tools (Bio & Brand-Statement
// Builder, Editorial Pitch Writer, and future ones). The artist writes text and
// gets a 0-100 score + structured feedback via src/lib/ai-review.ts. `kind`
// selects the builder + its rubric (see src/lib/studio.ts). `feedback` is the
// JSON ReviewResult of the latest scoring run.
model AiDraft {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // bio | editorial_pitch
  title     String    @default("")
  content   String    @default("")
  score     Int?
  feedback  String    @default("{}") // JSON ReviewResult
  scoredAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, kind, updatedAt])
}

// ===== Studio: Brand Kit (Track 1) =====
// One per artist. Palette + fonts stored as JSON; logos/assets are uploaded
// files (reuses /api/uploads); guidelines are markdown.
model BrandKit {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  colors     String   @default("[]") // JSON array of { name, hex }
  fonts      String   @default("[]") // JSON array of { name, usage }
  guidelines String   @default("") // markdown
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assets BrandAsset[]
}

model BrandAsset {
  id         String   @id @default(cuid())
  brandKitId String
  brandKit   BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)
  name       String
  url        String // /uploads/...
  createdAt  DateTime @default(now())

  @@index([brandKitId, createdAt])
}

// ===== Studio: Revenue & Budget Tracker (Track 6) =====
// A simple income/expense ledger. Amounts are integer minor units (cents) to
// avoid float drift.
model FinanceEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // income | expense
  category  String   @default("") // streaming | merch | shows | ads | gear | other
  label     String
  amount    Int // minor units (cents)
  currency  String   @default("USD")
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// ===== Studio: Merch & Gig Planner (Track 6) =====
model MerchItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  status    String   @default("idea") // idea | design | production | for_sale | sold_out
  cost      Int      @default(0) // cents
  price     Int      @default(0) // cents
  stock     Int      @default(0)
  notes     String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Gig {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue     String
  city      String    @default("")
  date      DateTime?
  status    String    @default("inquiry") // inquiry | confirmed | done | cancelled
  fee       Int       @default(0) // cents
  notes     String    @default("")
  createdAt DateTime  @default(now())

  @@index([userId, date])
}

// ===== Studio: Goal & Milestone Tracker (Track 8) =====
// User-defined career goals with sub-milestones. Distinct from the DERIVED
// gamification goals in src/lib/goals.ts (hence CareerGoal).
model CareerGoal {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  detail     String    @default("")
  targetDate DateTime?
  progress   Int       @default(0) // 0..100
  milestones String    @default("[]") // JSON array of { text, done }
  status     String    @default("active") // active | done | archived
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, status])
}

// ===== Studio: Fan CRM + Segmentation (Track 5) =====
model Fan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String   @default("")
  location  String   @default("")
  tags      String   @default("[]") // JSON array of strings (segments)
  source    String   @default("") // instagram | show | signup | ...
  notes     String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// A composed broadcast. Sending needs an email provider (not configured yet) —
// mirrors the app's "degrade gracefully until keys are set" pattern.
model Broadcast {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject        String
  body           String    @default("") // markdown
  segment        String    @default("") // targeted tag; "" = all fans
  recipientCount Int       @default(0)
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, createdAt])
}

// ===== Studio: Link-in-Bio Page Builder (Track 5) =====
// One per artist. Rendered on a PUBLIC (unauthenticated) route /u/[handle].
model LinkPage {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle    String   @unique
  title     String   @default("")
  bio       String   @default("")
  theme     String   @default("brand") // brand | accent | success | warning | brand-2
  links     String   @default("[]") // JSON array of { label, url }
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== Studio: Booking Scheduler (Track 7) =====
model Booking {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  contact   String    @default("")
  date      DateTime?
  status    String    @default("inquiry") // inquiry | held | confirmed | done | declined
  fee       Int       @default(0) // cents
  notes     String    @default("")
  createdAt DateTime  @default(now())

  @@index([userId, date])
}
