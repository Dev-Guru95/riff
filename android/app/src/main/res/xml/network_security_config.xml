<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production traffic is HTTPS only. No cleartext exemptions ship in the
         release build, so the session cookie can never cross the wire in clear. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
