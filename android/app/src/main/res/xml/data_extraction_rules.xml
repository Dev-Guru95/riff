<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules. Both transports are fully excluded so the session
     cookie database can never leave the device via backup or device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
