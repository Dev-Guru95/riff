<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Notification polling surfaces unread counts while the app is backgrounded. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- No CAMERA permission on purpose. Capture is delegated to the installed
         camera app via ACTION_IMAGE_CAPTURE, which needs no permission of ours.
         Worse, declaring it is actively harmful: once an app declares CAMERA,
         Android throws SecurityException on ACTION_IMAGE_CAPTURE until the user
         grants it at runtime — so declaring it without requesting it broke the
         very feature it looked like it was enabling. Fewer permissions also
         means less Play Console review scrutiny.
         If page JavaScript ever needs getUserMedia (no code does today), this
         permission and a runtime request both have to come back. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Package visibility (Android 11+). Without this, resolveActivity() for the
         camera returns null even when a camera app is installed, and the "take a
         photo" option silently disappears from the upload picker. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- The WebView cookie jar holds the live session JWT, so the app is excluded
         from cloud/device backup: that token must not be copied off this device
         and restored onto another one. -->
    <application
        android:name=".RiffApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Riff">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize|density"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Riff.Splash">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep links: a Skool lesson link opens the matching screen in-app. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="riff-app.onrender.com" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
